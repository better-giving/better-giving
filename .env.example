# the deployment's values, read by `docker compose up` (compose.yaml's `env_file`). copy to `.env`,
# which is gitignored, and fill it in. names only here: every value below is empty or a placeholder
# that cannot send mail or pass a real bot check. DEPLOY.md → Configuration values says what each
# one means.
#
# DATABASE_URL, PORT and HOST are not here: compose.yaml sets them for the container.

# the host port the app is published on. unset, 3000.
# BETTER_GIVING_PORT=""

# the staff credential, typed at /login with the username `admin`. refused when empty or under 12
# characters. generate one: `openssl rand -base64 24`.
ADMIN_PASSWORD=""

# the key that signs sign-in sessions. the server refuses to start without it and without
# ADMIN_PASSWORD. changing it signs everyone out. generate one: `openssl rand -base64 32`.
BETTER_AUTH_SECRET=""

# mail, over SMTP on port 465 only. example.org is reserved (RFC 2606), so these send nowhere.
SMTP_HOST="smtp.example.org"
SMTP_PORT="465"
SMTP_USERNAME="REPLACE_ME"
SMTP_PASSWORD="REPLACE_ME"
MAIL_FROM="donations@example.org"

# optional: cloudflare turnstile as the spam check on donations, with both keys set. unset, the
# donation form solves a self-hosted ALTCHA proof of work, which needs no account.
# TURNSTILE_SITE_KEY=""
# TURNSTILE_SECRET_KEY=""

# the header a fronting proxy writes the client address into, e.g. x-forwarded-for. unset, the
# address is the TCP peer and no caller-sent header is read (packages/app/src/lib/server/runtime/client-ip.ts).
# set it only when every request passes through a proxy that sets it.
# TRUSTED_PROXY_HEADER=""

# optional: a pinned canonical origin.
# BETTER_AUTH_URL=""

# stripe: all three, or none.
# STRIPE_SECRET_KEY=""
# STRIPE_PUBLISHABLE_KEY=""
# STRIPE_WEBHOOK_SECRET=""

# paypal
# PAYPAL_CLIENT_ID=""
# PAYPAL_CLIENT_SECRET=""
# PAYPAL_API_URL=""
# PAYPAL_WEBHOOK_ID=""
# PAYPAL_CHARITY_RATE_APPROVED=""

# chariot
# CHARIOT_API_KEY=""
# CHARIOT_API_URL=""
# CHARIOT_CONNECT_ID=""
# CHARIOT_WEBHOOK_SECRET=""

# nowpayments
# NOWPAYMENTS_API_KEY=""
# NOWPAYMENTS_IPN_SECRET=""
# NOWPAYMENTS_OUTCOME_CURRENCY=""

# quickbooks online
# QUICKBOOKS_CLIENT_ID=""
# QUICKBOOKS_CLIENT_SECRET=""
# QUICKBOOKS_API_URL=""
