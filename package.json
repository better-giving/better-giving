{
	"name": "better-giving",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"packageManager": "pnpm@10.19.0",
	"scripts": {
		"dev": "pnpm --filter @better-giving/app dev",
		"build:embed": "pnpm --filter @better-giving/app build:embed",
		"build": "pnpm --filter @better-giving/app build",
		"gallery": "pnpm --filter @better-giving/gallery dev",
		"emails": "pnpm --filter @better-giving/emails-preview dev",
		"form": "pnpm --filter @better-giving/form dev",
		"doctor": "pnpm --filter @better-giving/app run doctor",
		"drizzle-kit": "pnpm --filter @better-giving/app exec drizzle-kit",
		"db:migrate": "pnpm --filter @better-giving/app db:migrate",
		"db:seed": "pnpm --filter @better-giving/app db:seed",
		"db:backup": "pnpm --filter @better-giving/app db:backup",
		"setup-webhook:chariot": "pnpm --silent --filter @better-giving/app setup-webhook:chariot",
		"setup-webhook:paypal": "pnpm --silent --filter @better-giving/app setup-webhook:paypal",
		"setup-webhook:stripe": "pnpm --silent --filter @better-giving/app setup-webhook:stripe",
		"prepare": "pnpm --filter @better-giving/app prepare",
		"check": "pnpm -r --workspace-concurrency=1 check",
		"lint": "biome lint .",
		"format": "biome format --write .",
		"test": "pnpm -r --workspace-concurrency=1 test",
		"test:browser": "pnpm -r --workspace-concurrency=1 test:browser"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.9",
		"typescript": "catalog:"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild"
		]
	}
}
