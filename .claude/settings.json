{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"env": {
		"CLAUDE_CODE_ENABLE_TODO_TOOLS": "1"
	},
	"extraKnownMarketplaces": {
		"kru": {
			"source": {
				"source": "github",
				"repo": "ap-justin/kru"
			}
		}
	},
	"enabledPlugins": {
		"kru@kru": true
	},
	"hooks": {
		"SessionStart": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
					}
				]
			}
		]
	}
}
