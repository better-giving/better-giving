{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"env": {
		"CLAUDE_CODE_ENABLE_TODO_TOOLS": "1",
		"KRU_PROJECT": "better-giving-docker"
	},
	"extraKnownMarketplaces": {
		"kru": {
			"source": {
				"source": "github",
				"repo": "ap-justin/kru"
			}
		}
	},
	"enabledPlugins": {
		"kru@kru": true
	},
	"hooks": {
		"SessionStart": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "bash \"$CLAUDE_PROJECT_DIR/.claude/cloud-install.sh\""
					}
				],
				"matcher": "startup|resume"
			}
		]
	}
}
