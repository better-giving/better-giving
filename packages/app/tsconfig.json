{
	// ../../tsconfig.base.json is the repository's strictness and this file adds only what a react
	// router app on node needs on top of it.
	//
	// `.react-router/types` is written by `react-router typegen`, which the `check` and `prepare`
	// scripts both run. `rootDirs` is what lets a route module import its own generated types as a
	// relative sibling — `./+types/root` resolves into that directory rather than beside the screen.
	//
	// `Env` is a global declared in src/lib/server/runtime/env.ts, which `src/**` already includes.
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"module": "esnext",
		"target": "esnext",
		"lib": ["esnext", "dom", "dom.iterable"],
		"types": ["node", "vite/client"],
		"jsx": "react-jsx",
		// nothing this program holds is authored in JS, and what `allowJs` lets in is generated: a
		// build's output is not this program's to check. the operator scripts are authored in JS and are
		// checked — they are ./scripts/tsconfig.json's, which `check` runs first.
		"checkJs": false,
		"verbatimModuleSyntax": true,
		"noEmit": true,
		"rootDirs": [".", "./.react-router/types"],
		// the alias most of src/ already imports through, and ./vite.config.ts declares the same one
		// for the bundler — neither knows about the other.
		"paths": {
			"$lib/*": ["./src/lib/*"]
		}
	},
	"include": [
		"src/**/*.ts",
		"src/**/*.tsx",
		"*.ts",
		"vite/**/*.ts",
		"vite/**/*.d.ts",
		"server/**/*.ts",
		".react-router/types/**/*"
	]
}
