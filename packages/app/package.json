{
	"name": "@better-giving/app",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "node --env-file-if-exists=.env server/index.ts --dev",
		"start": "node server/index.ts",
		"build:embed": "pnpm --filter @better-giving/form build",
		"build": "pnpm run build:embed && node scripts/stage-embed.js && vite build",
		"doctor": "node scripts/doctor.js",
		"db:migrate": "node --env-file-if-exists=.env scripts/migrate.ts",
		"db:seed": "node --env-file-if-exists=.env scripts/seed.ts",
		"db:backup": "node --env-file-if-exists=.env scripts/backup.ts",
		"prepare": "react-router typegen",
		"check": "tsc -p scripts/tsconfig.json && react-router typegen && tsc --noEmit",
		"test": "vitest --run"
	},
	"devDependencies": {
		"@react-router/dev": "catalog:",
		"@react-router/fs-routes": "catalog:",
		"@types/node": "catalog:",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"ajv": "8.20.0",
		"ajv-formats": "3.0.1",
		"drizzle-kit": "0.31.10",
		"happy-dom": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:"
	},
	"dependencies": {
		"@ark-ui/react": "catalog:",
		"@better-giving/emails": "workspace:*",
		"@better-giving/form": "workspace:*",
		"@better-giving/operator": "workspace:*",
		"@conform-to/react": "catalog:",
		"@conform-to/zod": "catalog:",
		"@libsql/client": "0.18.0",
		"@paypal/paypal-server-sdk": "2.5.0",
		"@remix-run/node-fetch-server": "0.13.3",
		"@tiptap/core": "catalog:",
		"@tiptap/extension-bold": "catalog:",
		"@tiptap/extension-document": "catalog:",
		"@tiptap/extension-italic": "catalog:",
		"@tiptap/extension-link": "catalog:",
		"@tiptap/extension-list": "catalog:",
		"@tiptap/extension-paragraph": "catalog:",
		"@tiptap/extension-text": "catalog:",
		"@tiptap/pm": "catalog:",
		"@tiptap/react": "catalog:",
		"better-auth": "1.6.25",
		"drizzle-orm": "0.45.2",
		"nodemailer": "10.0.14",
		"react": "catalog:",
		"react-dom": "catalog:",
		"react-router": "catalog:",
		"sirv": "3.0.2",
		"stripe": "22.4.0",
		"uqr": "0.1.3",
		"uuidv7": "1.2.1",
		"xstate": "catalog:",
		"zod": "catalog:"
	}
}
