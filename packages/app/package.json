{
	"name": "@better-giving/app",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build:embed": "pnpm --filter @better-giving/form build",
		"build": "pnpm run build:embed && node scripts/stage-embed.js && vite build",
		"preview": "pnpm run build && node scripts/preflight-deploy.js && wrangler dev",
		"deploy": "pnpm run build && node scripts/preflight-deploy.js && wrangler d1 migrations apply DB --remote && wrangler deploy",
		"deploy:test": "CLOUDFLARE_ENV=test pnpm run build && node scripts/preflight-deploy.js --env test && wrangler d1 migrations apply DB --remote --env test && wrangler deploy --env test",
		"deploy:vars": "node scripts/deploy-vars.js .deploy.vars",
		"login": "wrangler login",
		"whoami": "wrangler whoami",
		"doctor": "node scripts/doctor.js",
		"logs": "wrangler tail",
		"secret:delete": "wrangler secret delete",
		"secret:list": "wrangler secret list",
		"turnstile:keys": "node scripts/turnstile-keys.js",
		"db:create": "wrangler d1 create better-giving --no-update-config",
		"db:create:test": "wrangler d1 create better-giving-test --no-update-config",
		"db:info": "wrangler d1 info better-giving",
		"db:export": "wrangler d1 export better-giving --remote",
		"prepare": "react-router typegen && wrangler types",
		"check": "tsc -p scripts/tsconfig.json && react-router typegen && tsc --noEmit",
		"test": "vitest --run"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "1.53.0",
		"@cloudflare/vitest-pool-workers": "0.22.0",
		"@react-router/dev": "catalog:",
		"@react-router/fs-routes": "catalog:",
		"@types/node": "catalog:",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"drizzle-kit": "0.31.10",
		"happy-dom": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:",
		"wrangler": "4.124.0"
	},
	"dependencies": {
		"@better-giving/emails": "workspace:*",
		"@better-giving/form": "workspace:*",
		"@better-giving/operator": "workspace:*",
		"@conform-to/react": "catalog:",
		"@conform-to/zod": "catalog:",
		"@paypal/paypal-server-sdk": "2.5.0",
		"better-auth": "1.6.25",
		"drizzle-orm": "0.45.2",
		"react": "catalog:",
		"react-dom": "catalog:",
		"react-router": "catalog:",
		"stripe": "22.4.0",
		"uuidv7": "1.2.1",
		"worker-mailer": "1.2.1",
		"xstate": "catalog:",
		"zod": "catalog:"
	}
}
