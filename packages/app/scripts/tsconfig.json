{
	// the operator scripts and their specs are their own program: ../tsconfig.json's jsx and `$lib`
	// alias are none of theirs, and `check` runs this file before that one.
	//
	// they are JavaScript, and `checkJs` holds them to the same strictness as everything else. the
	// types are JSDoc, which is the only way to state one in a file node runs directly.
	"extends": "../../../tsconfig.base.json",
	"compilerOptions": {
		"types": ["node"],
		"checkJs": true,
		"noEmit": true
	},
	"include": ["**/*.ts", "**/*.js"]
}
