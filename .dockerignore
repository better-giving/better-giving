# the build context. what is left out here is either rebuilt inside the image (node_modules, build
# output, route typegen, the staged embed) or never belongs in it: a local database, a value file,
# the design artboards.

.git
**/node_modules
**/build
**/dist
**/.react-router
packages/app/static/embed.js
packages/app/static/embed/

# a value file must never reach a layer: compose hands .env to the container at run time.
.env
.env.*
!.env.example
**/.dev.vars
**/.dev.vars.*
**/.deploy.vars
**/.deploy.vars.*
**/.console
**/.wrangler
**/*.db
**/*.db-wal
**/*.db-shm

packages/design
.design-work
.claude
.cursor
.github
**/.DS_Store
